{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix backend",
  "buildCommand": "npm run build --prefix backend && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{backend/dist/**,backend/prisma/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**,backend/node_modules/**}"
    }
  }
}
