# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

NODE_ENV=development
PORT=4000

JWT_ISSUER=marketplace-api
JWT_SECRET=generate-a-strong-random-secret
JWT_REFRESH_SECRET=generate-another-strong-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

CORS_ORIGIN=http://localhost:5173

APP_PUBLIC_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Marketplace <noreply@example.com>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
