# WhatsApp number with country code, digits only
VITE_WHATSAPP_NUMBER=9955XXXXXXXX

# Supabase (Vite uses VITE_ prefix — same values as NEXT_PUBLIC_* from the dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional API base override (defaults: /v1 locally, /api/v1 on Vercel)
# VITE_API_BASE=/api/v1
